<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>CITi × Mezzalira | Diagnóstico de Dados</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root{--bg:#F0F8F4;--card:#fff;--tx:#0E2A2F;--mut:#4F6B6B;--line:#D7E8E0;--ac:#38B490;--ac2:#58FB87;--cell:56,180,144;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#102A30;--card:#193940;--tx:#EAFBF2;--mut:#9FC4BA;--line:#2A5560;--ac:#58FB87;--ac2:#38B490;--cell:88,251,135}}
:root[data-theme="dark"]{--bg:#102A30;--card:#193940;--tx:#EAFBF2;--mut:#9FC4BA;--line:#2A5560;--ac:#58FB87;--ac2:#38B490;--cell:88,251,135}
html{--px:max(5vw,calc((100vw - 1200px)/2 + 5vw));scroll-behavior:smooth;scroll-padding-top:calc(env(safe-area-inset-top,0px) + 70px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:400 16px/1.55 "Plus Jakarta Sans",system-ui,sans-serif}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:#193940;z-index:60}
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;display:flex;align-items:center;justify-content:space-between;padding:14px var(--px);flex-wrap:wrap;gap:8px;background:rgba(25,57,64,.86);backdrop-filter:blur(12px);color:#fff}
.logo{font-weight:800;font-size:clamp(15px,2.3vw,20px);letter-spacing:-.3px}.logo b{color:#58FB87}
nav a{color:#BFE3D6;text-decoration:none;font-size:14px;margin-left:22px}
nav .cta{background:#58FB87;color:#193940;padding:9px 18px;border-radius:99px;font-weight:600}
.hero{position:relative;overflow:hidden;color:#fff;background:#193940;padding:90px var(--px) 110px}
.hero::before,.hero::after{content:"";position:absolute;border-radius:50%;filter:blur(70px);opacity:.55}
.hero::before{width:520px;height:520px;right:-120px;top:-140px;background:radial-gradient(#58FB87,transparent 70%)}
.hero::after{width:420px;height:420px;left:-100px;bottom:-200px;background:radial-gradient(#38B490,transparent 70%)}
.hero>*{position:relative;z-index:1}
.tag{display:inline-block;font-size:13px;font-weight:600;color:#58FB87;border:1px solid #2F6B6B;border-radius:99px;padding:5px 14px}
h1{font-size:clamp(34px,6vw,64px);line-height:1.05;letter-spacing:-2px;margin:22px 0 18px;font-weight:800;max-width:800px}
h1 em{font-style:normal;background:linear-gradient(90deg,#58FB87,#38B490);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{color:#BFE3D6;max-width:620px;font-size:18px;margin:0}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin-top:46px}
.kpi{background:rgba(255,255,255,.06);border:1px solid #2F6B6B;border-radius:18px;padding:20px}
.kpi b{display:block;font-size:clamp(24px,3.4vw,34px);letter-spacing:-1px}.kpi span{font-size:13px;color:#9FC4BA}
section{padding:70px 5vw;max-width:1200px;margin:auto}
h2{font-size:clamp(26px,4vw,40px);letter-spacing:-1.2px;line-height:1.1;margin:0 0 10px;font-weight:800}
.sub{color:var(--mut);max-width:640px;margin:0 0 30px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:24px;padding:22px;box-shadow:0 20px 50px -30px rgba(56,180,144,.35)}
.ctrl{display:flex;flex-wrap:wrap;gap:14px 28px;margin-bottom:18px}
.grp small{display:block;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--mut);margin-bottom:6px}
.seg{display:flex;flex-wrap:wrap;gap:6px}
button{font:inherit;font-size:14px;font-weight:600;color:var(--tx);background:transparent;border:1px solid var(--line);border-radius:99px;padding:8px 15px;cursor:pointer;transition:.18s}
button:hover{border-color:var(--ac)}
button.on{background:linear-gradient(90deg,var(--ac),var(--ac2));border-color:transparent;color:#193940}
.dis{opacity:.35;pointer-events:none}
.stage{position:relative;min-height:380px}
#cv{width:100%!important;height:420px!important}
.heat{display:grid;gap:5px;overflow-x:auto;padding-bottom:6px}
.heat div{padding:11px 8px;border-radius:9px;font-size:13px;text-align:center;font-variant-numeric:tabular-nums;white-space:nowrap}
.heat .h{font-weight:700;color:var(--mut)}.heat .n{text-align:left;font-weight:600;background:none;padding-left:0;position:sticky;left:0;background:var(--card)}
.heat .c{transition:box-shadow .15s}.heat .c:hover{box-shadow:inset 0 0 0 2px var(--ac)}.heat .t{background:var(--ac2);color:#0E2A2F;font-weight:700}
.note{margin:16px 0 0;font-size:14px;color:var(--mut);border-left:3px solid var(--ac);padding-left:12px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:24px}
.card b{display:block;font-size:34px;letter-spacing:-1.5px;background:linear-gradient(90deg,var(--tx),var(--ac));-webkit-background-clip:text;background-clip:text;color:transparent}
.card h3{margin:6px 0;font-size:17px}.card p{margin:0;color:var(--mut);font-size:14px}
table{width:100%;border-collapse:collapse;font-size:14px}th,td{text-align:left;padding:12px 10px;border-bottom:1px solid var(--line)}
th{font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--mut)}td.r{text-align:right;font-weight:700;color:var(--ac)}
.tw{overflow-x:auto}
footer{background:#193940;color:#9FC4BA;text-align:center;padding:48px 5vw;font-size:14px}
footer h3{color:#fff;font-size:24px;margin:0 0 8px;letter-spacing:-.5px}
.fade{animation:f .7s both}@keyframes f{from{opacity:0;transform:translateY(14px)}}
</style>
</head>
<body>
<nav><div class="logo"><b>/</b> Processo Seletivo - Flávio Norberto</div><div><a href="#explorar">Explorar dados</a><a href="#insights">Insights</a><a class="cta" href="#qualidade">Qualidade dos dados</a></div></nav>

<header class="hero">
  <span class="tag fade">✦ Diagnóstico de Dados · Metalúrgica Mezzalira</span>
  <h1 class="fade">Do dado bagunçado ao <em>dado útil.</em></h1>
  <p class="fade">Limpamos a base de pedidos de jan a abr de 2026 e transformamos em uma leitura clara de quem compra, onde e quando. Explore os dados do jeito que preferir.</p>
  <div class="kpis fade">
    <div class="kpi"><b id="k1">R$ 0</b><span>faturamento total</span></div>
    <div class="kpi"><b id="k2">0</b><span>pedidos válidos</span></div>
    <div class="kpi"><b>Recife</b><span>cidade que mais comprou</span></div>
    <div class="kpi"><b>Março</b><span>mês de maior faturamento</span></div>
  </div>
</header>

<section id="explorar">
  <h2>Explore os dados</h2>
  <p class="sub">Escolha a tabela, a visualização e o filtro. Passe o mouse sobre os elementos para ver os valores exatos.</p>
  <div class="panel">
    <div class="ctrl">
      <div class="grp"><small>Tabela</small><div class="seg" id="tab"></div></div>
      <div class="grp"><small>Visualização</small><div class="seg" id="typ">
        <button data-v="heat" class="on">Mapa de calor</button><button data-v="stack">Barras empilhadas</button><button data-v="hbar">Ranking</button><button data-v="line">Linhas</button><button data-v="pie">Pizza</button></div></div>
      <div class="grp" id="mg"><small id="mgl">Período</small><div class="seg" id="mon"></div></div>
    </div>
    <div class="stage"><div id="heat" class="heat"></div><canvas id="cv"></canvas></div>
    <p class="note" id="note"></p>
  </div>
</section>

<section id="insights">
  <h2>O que os dados dizem</h2>
  <p class="sub">Três leituras que podem guiar decisões comerciais.</p>
  <div class="cards">
    <div class="card"><b>31%</b><h3>Recife concentra o faturamento</h3><p>R$ 55.260 de R$ 178.340. A cidade lidera, com pico de R$ 29.730 em março.</p></div>
    <div class="card"><b>45%</b><h3>Março é o mês decisivo</h3><p>R$ 79.460 em um único mês, mais que jan e abr somados. Abril cai para R$ 25.290.</p></div>
    <div class="card"><b>46%</b><h3>3 clientes sustentam quase metade</h3><p>Grades Caruaru, Calhas Olinda e Estaleiro Porto Novo somam R$ 82.780.</p></div>
  </div>
</section>

<section id="qualidade">
  <h2>Como tratamos a base</h2>
  <p class="sub">A planilha original tinha 60 linhas. Após a limpeza, restaram 53 pedidos válidos. Tudo foi registrado em log.</p>
  <div class="panel tw"><table>
    <tr><th>O que encontramos</th><th>O que fizemos</th><th style="text-align:right">Linhas</th></tr>
    <tr><td>Linhas vazias</td><td>Removidas</td><td class="r">3</td></tr>
    <tr><td>Pedidos duplicados</td><td>Mantida a primeira ocorrência</td><td class="r">4</td></tr>
    <tr><td>Cidades escritas de formas diferentes</td><td>“recife” e “REC” padronizadas para Recife</td><td class="r">10</td></tr>
    <tr><td>Valores digitados como texto</td><td>“R$” removido e convertido para número</td><td class="r">7</td></tr>
    <tr><td>Datas em formatos diferentes</td><td>Padronizadas para dd/mm/aaaa</td><td class="r">17</td></tr>
  </table></div>
</section>

<footer><h3>Dados limpos, decisões melhores.</h3><p>Apresentação elaborada por Flávio Norberto · Desafio de Dados CITi · Etapa 1</p></footer>

<script>
const MES=["Jan","Fev","Mar","Abr"],PROD=["Barra chata 1\"","Cantoneira 1/2\"","Chapa de aço 3 mm","Perfil U enrijecido","Telha trapezoidal","Tubo galvanizado 2\""];
const T={
cm:{nome:"Faturamento por cliente e mês",u:"R$",fl:"Período",cols:MES,rows:{"Grades Caruaru":[3570,15030,9990,1040],"Calhas Olinda":[0,10100,6780,11190],"Estaleiro Porto Novo":[0,6310,18770,0],"Serralheria Capibaribe":[6850,8670,2140,0],"Indústria Guararapes":[0,0,14490,1120],"Irrigação Vale Forte":[4610,4800,1590,3610],"Metalfer Agreste":[0,0,7620,5890],"Estruturas Piedade":[0,3920,8330,0],"Agro Estruturas São Francisco":[4500,3970,0,0],"Esquadrias Recife Antigo":[0,0,5480,2440],"Construtora Boa Vista":[0,1260,3340,0],"Serralheria Alto da Sé":[0,0,930,0]}},
im:{nome:"Faturamento por cidade e mês",u:"R$",fl:"Período",cols:MES,rows:{"Recife":[6850,16240,29730,2440],"Caruaru":[3570,15030,17610,6930],"Olinda":[0,10100,7710,11190],"Jaboatão dos Guararapes":[0,3920,22820,1120],"Petrolina":[9110,8770,1590,3610]}},
pm:{nome:"Produtos vendidos por mês",u:"un.",fl:"Período",cols:MES,rows:{"Chapa de aço 3 mm":[1,2,7,1],"Telha trapezoidal":[1,3,4,2],"Cantoneira 1/2\"":[1,3,4,1],"Barra chata 1\"":[1,2,4,1],"Perfil U enrijecido":[1,3,3,1],"Tubo galvanizado 2\"":[1,2,2,2]}},
cq:{nome:"Clientes por quantidade de produtos",u:"un.",fl:"Produto",cols:PROD,rows:{"Calhas Olinda":[1,1,1,0,2,3],"Grades Caruaru":[1,1,2,2,0,1],"Estaleiro Porto Novo":[0,1,0,3,2,0],"Indústria Guararapes":[2,2,0,1,1,0],"Serralheria Capibaribe":[1,1,3,0,1,0],"Irrigação Vale Forte":[0,1,1,0,2,1],"Metalfer Agreste":[1,1,1,0,0,1],"Agro Estruturas São Francisco":[1,0,0,1,1,0],"Estruturas Piedade":[1,0,1,0,1,0],"Construtora Boa Vista":[0,1,1,0,0,0],"Esquadrias Recife Antigo":[0,0,0,1,0,1],"Serralheria Alto da Sé":[0,0,1,0,0,0]}},
cv:{nome:"Clientes por valor de produto",u:"R$",fl:"Produto",cols:PROD,rows:{"Grades Caruaru":[3570,5480,5550,10520,0,4510],"Calhas Olinda":[1330,4470,4400,0,1360,16510],"Estaleiro Porto Novo":[0,3900,0,10680,10500,0],"Serralheria Capibaribe":[4040,2390,9290,0,1940,0],"Indústria Guararapes":[1920,5600,0,4290,3800,0],"Irrigação Vale Forte":[0,1350,1590,0,8410,3260],"Metalfer Agreste":[5960,440,1220,0,0,5890],"Estruturas Piedade":[2980,0,5350,0,3920,0],"Agro Estruturas São Francisco":[630,0,0,4500,3340,0],"Esquadrias Recife Antigo":[0,0,0,2440,0,5480],"Construtora Boa Vista":[0,1260,3340,0,0,0],"Serralheria Alto da Sé":[0,0,930,0,0,0]}}};
const S={tab:"cm",typ:"heat",mon:-1};
const NOTE={heat:"Quanto mais intensa a cor, maior o valor naquela célula. Traço indica zero.",stack:"Cada barra é uma coluna da tabela, dividida pela contribuição de cada linha.",hbar:"Ranking do maior para o menor. Use o filtro para ver o líder em cada coluna.",line:"A trajetória de cada linha ao longo das colunas. Funciona melhor com poucas linhas.",pie:"A fatia mostra a participação no total. Use o filtro para comparar colunas."};
const num=v=>v.toLocaleString("pt-BR"),fmt=(v,u)=>u==="R$"?"R$ "+num(v):num(v)+" un.";
const col=(i,n)=>`hsl(${95+i*(125/n)} 62% ${i%2?40:58}%)`;
const css=n=>getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const $=id=>document.getElementById(id);
let ch;
function rows(){const t=T[S.tab];return Object.entries(t.rows).map(([k,v])=>({k,v,t:v.reduce((a,b)=>a+b,0)})).sort((a,b)=>b.t-a.t)}
function monBtns(){const t=T[S.tab];$("mgl").textContent=t.fl;$("mon").innerHTML=["Todos",...t.cols].map((c,i)=>`<button data-v="${i-1}" class="${i-1===S.mon?"on":""}">${c}</button>`).join("")}
function render(){
  const t=T[S.tab],u=t.u,R=rows(),n=R.length,isH=S.typ==="heat",C=t.cols;
  $("heat").style.display=isH?"grid":"none";$("cv").style.display=isH?"none":"block";
  $("mg").classList.toggle("dis",!["hbar","pie"].includes(S.typ));
  $("note").textContent=NOTE[S.typ];
  if(ch){ch.destroy();ch=null}
  if(isH){
    const mx=Math.max(...R.flatMap(r=>r.v)),h=$("heat");
    h.style.gridTemplateColumns=`minmax(130px,1.6fr) repeat(${C.length+1},minmax(62px,1fr))`;
    h.innerHTML=["",...C,"Total"].map(x=>`<div class="h">${x}</div>`).join("")+R.map(r=>`<div class="n">${r.k}</div>`+r.v.map((x,j)=>`<div class="c" title="${r.k} · ${C[j]}: ${fmt(x,u)}" style="background:rgba(${css("--cell")},${x?(.14+.86*x/mx).toFixed(2):.05});color:${x/mx>.5?"#0E2A2F":"inherit"}">${x?num(x):"–"}</div>`).join("")+`<div class="c t">${num(r.t)}</div>`).join("");
    return}
  Chart.defaults.color=css("--mut");Chart.defaults.font.family='"Plus Jakarta Sans",sans-serif';
  const grid={color:css("--line")},ticks={callback:v=>u==="R$"?"R$ "+v/1000+" mil":v};
  const leg={position:"bottom",labels:{boxWidth:10}};
  const tip={callbacks:{label:c=>` ${S.typ==="hbar"?"":c.dataset.label+": "}${fmt(c.raw,u)}`}};
  let cfg;
  if(S.typ==="stack")cfg={type:"bar",data:{labels:C,datasets:R.map((r,i)=>({label:r.k,data:r.v,backgroundColor:col(i,n),borderRadius:3}))},options:{scales:{x:{stacked:true,grid:{display:false}},y:{stacked:true,grid,ticks}},plugins:{tooltip:tip,legend:leg}}};
  else if(S.typ==="line")cfg={type:"line",data:{labels:C,datasets:R.map((r,i)=>({label:r.k,data:r.v,borderColor:col(i,n),backgroundColor:col(i,n),tension:.35,borderWidth:2.5,pointRadius:4}))},options:{scales:{x:{grid:{display:false}},y:{grid,ticks}},plugins:{tooltip:tip,legend:leg}}};
  else{
    const L=R.map((r,i)=>({k:r.k,x:S.mon<0?r.t:r.v[S.mon],c:col(i,n)})).filter(r=>r.x>0).sort((a,b)=>b.x-a.x);
    const d={labels:L.map(r=>r.k),datasets:[{data:L.map(r=>r.x),backgroundColor:L.map(r=>r.c),borderColor:css("--card"),borderWidth:S.typ==="pie"?2:0,borderRadius:S.typ==="pie"?0:6}]};
    if(S.typ==="hbar")cfg={type:"bar",data:d,options:{indexAxis:"y",scales:{x:{grid,ticks},y:{grid:{display:false}}},plugins:{legend:{display:false},tooltip:tip}}};
    else cfg={type:"pie",data:d,options:{plugins:{legend:{position:"right",labels:{boxWidth:10}},tooltip:{callbacks:{label:c=>` ${fmt(c.raw,u)} (${(100*c.raw/c.dataset.data.reduce((a,b)=>a+b,0)).toFixed(1)}%)`}}}}};
  }
  cfg.options.responsive=true;cfg.options.maintainAspectRatio=false;
  ch=new Chart($("cv"),cfg);
}
$("tab").innerHTML=Object.entries(T).map(([k,v])=>`<button data-v="${k}" class="${k===S.tab?"on":""}">${v.nome}</button>`).join("");
function bind(id,fn){$(id).onclick=e=>{const b=e.target.closest("button");if(!b)return;fn(b.dataset.v);document.querySelectorAll("#"+id+" button").forEach(x=>x.classList.toggle("on",x===b));render()}}
bind("tab",v=>{S.tab=v;S.mon=-1;monBtns()});bind("typ",v=>S.typ=v);bind("mon",v=>S.mon=+v);
matchMedia("(prefers-color-scheme:dark)").addEventListener("change",render);
function count(id,to,f){const el=$(id),t0=performance.now();(function s(t){const p=Math.min((t-t0)/1200,1);el.textContent=f(Math.round(to*(1-Math.pow(1-p,3))));if(p<1)requestAnimationFrame(s)})(t0)}
count("k1",178340,v=>"R$ "+num(v));count("k2",53,v=>v);
monBtns();render();
</script>
</body>
</html>
